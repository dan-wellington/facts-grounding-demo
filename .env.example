# Copy this file to .env and fill in your own API keys.
# Never commit .env — it's listed in .gitignore.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Judge model (factuality verdict). Default gpt-5.
JUDGE_MODEL=gpt-5

# Extractor model (atomic-claim decomposition). Default claude-sonnet-4-6.
EXTRACTOR_MODEL=claude-sonnet-4-6

# Optional — server port. Default 3022.
PORT=3022
